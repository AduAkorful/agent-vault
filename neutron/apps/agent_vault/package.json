{
  "main": "dist/index.js",
  "packages": {},
  "name": "neutron-agent-vault",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "node --experimental-strip-types build.ts && npm run mogen",
    "mogen": "bun ../../packages/neutron-scripts/src/mogen.ts",
    "mopack": "node --experimental-strip-types package_mopack.ts",
    "schema": "bun ../../packages/neutron-scripts/src/method_schema.ts",
    "package:metadata": "bun ../../packages/neutron-scripts/src/package_metadata.ts",
    "validate": "bun ../../packages/neutron-scripts/src/validate.ts",
    "package": "npm run validate && npm run build && npm run mopack && npm run schema && npm run package:metadata && bun ../../packages/neutron-scripts/src/pack.ts",
    "watch": "bun build.ts watch",
    "test:memory": "node --experimental-strip-types scripts/run_memory_test.ts",
    "test": "npm run package && bun test test/package.test.ts && npm run test:memory"
  },
  "author": "",
  "license": "LicenseRef-Neutron-Sovereign-Application-License-1.0",
  "description": "Policy-governed agent vault — human dashboard, agent tools, and real ICRC-1 settlement on Neutron",
  "dependencies": {
    "neutron-design-system": "^1.1.0",
    "neutron-tools": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@dfinity/candid": "^3.4.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "icblast": "^4.3.0",
    "neutron-scripts": "^1.1.0"
  }
}
